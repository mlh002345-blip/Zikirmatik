# Supabase projenizin "Data API" (Project URL) ve "API Keys" (Publishable/anon
# key) sayfalarından alın. URL'in sonunda /rest/v1/ gibi bir yol OLMAMALI —
# sadece https://xxxx.supabase.co şeklinde, çıplak proje adresi olmalı.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Bu dosyayı .env olarak kopyalayıp kendi değerlerinizi girin:
#   cp .env.example .env
